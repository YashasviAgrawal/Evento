{
  "name": "tixit",
  "version": "1.0.0",
  "private": true,
  "description": "Tixit — event discovery and ticket booking platform (customers, organizers, admin).",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "start": "concurrently -n api,web -c cyan,magenta \"npm:start:server\" \"npm:start:web\"",
    "start:server": "npm run start --workspace server",
    "start:web": "npm run start --workspace web",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "cms:user": "npm run cms:user --workspace server --",
    "db:reset": "npm run db:reset --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "lint": "npm run lint --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "package.json": "^2.0.1"
  }
}
