# ─────────────────────────────────────────────────────────────
# Evento — environment configuration
# Copy to .env and fill in. Everything with a sane default can
# be left blank in local development.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://evento:evento@127.0.0.1:5432/evento
DATABASE_SSL=false
PG_POOL_MAX=10

# ── Auth ────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Signs QR ticket payloads so forged tickets fail verification
QR_SECRET=dev-qr-secret-change-me-0123456789abcdef
BCRYPT_ROUNDS=10

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# When true, the OTP is returned in the API response and logged (dev only)
OTP_DEV_ECHO=true

# ── Payments: Razorpay ──────────────────────────────────────
# Leave blank to run in mock mode (checkout is simulated locally).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# ── Email: Resend ───────────────────────────────────────────
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=
MAIL_FROM="Evento <tickets@evento.test>"

# ── Storage: Cloudinary (falls back to local disk) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ── Business rules ──────────────────────────────────────────
# Default platform commission (%) applied to organizer revenue.
DEFAULT_COMMISSION_PERCENT=10
# How long a pending booking holds inventory before it is released.
BOOKING_HOLD_MINUTES=15
# Default GST/tax percentage applied to ticket subtotals.
DEFAULT_TAX_PERCENT=18
# Per-order convenience fee (%)
DEFAULT_CONVENIENCE_FEE_PERCENT=2

# ── Frontend (web workspace) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_NAME=Tixit
# Canonical production URL — used for canonical tags, sitemap.xml and Open Graph.
# Set this to your real domain (e.g. https://www.tixit.in) in production.
NEXT_PUBLIC_SITE_URL=https://www.tixit.in
