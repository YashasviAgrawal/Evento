# ─────────────────────────────────────────────────────────────
# Tixit — environment configuration
# Copy to .env and fill in. Everything with a sane default can
# be left blank in local development.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://evento:evento@127.0.0.1:5432/evento
DATABASE_SSL=false
PG_POOL_MAX=10

# ── Auth ────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Signs QR ticket payloads so forged tickets fail verification
QR_SECRET=dev-qr-secret-change-me-0123456789abcdef
BCRYPT_ROUNDS=10

# ── CMS (Content Studio, /cms) ──────────────────────────────
# The CMS authenticates against its own account table with its own key. Keep
# this DIFFERENT from JWT_ACCESS_SECRET — a distinct secret is what makes a
# platform token fail verification at a /cms endpoint instead of relying on a
# role check to reject it.  Generate with:  openssl rand -hex 48
CMS_JWT_ACCESS_SECRET=dev-cms-access-secret-change-me-0123456789abcdef
CMS_JWT_ACCESS_TTL=30m
CMS_SESSION_TTL=7d

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# When true, the OTP is returned in the API response and logged (dev only)
OTP_DEV_ECHO=true

# ── Payments: Razorpay ──────────────────────────────────────
# Leave blank to run in mock mode (checkout is simulated locally).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# ── Email: Resend ───────────────────────────────────────────
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=
MAIL_FROM="Tixit <tickets@tixit.in>"

# ── Google sign-in ──────────────────────────────────────────
# OAuth 2.0 "Web application" client ID from https://console.cloud.google.com
# → APIs & Services → Credentials. Leave blank to hide the Google button.
#
# Authorised JavaScript origins must list every origin the button is shown on
# (e.g. http://localhost:3002 in dev, https://www.tixit.in in production).
# No client *secret* is needed: the browser only ever hands back an ID token,
# which the API verifies against Google using this client ID as the audience.
GOOGLE_CLIENT_ID=
# Same value again — the browser bundle can only read NEXT_PUBLIC_* variables.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Storage: Cloudinary (falls back to local disk) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ── Business rules ──────────────────────────────────────────
# Default platform commission (%) applied to organizer revenue.
DEFAULT_COMMISSION_PERCENT=10
# How long a pending booking holds inventory before it is released.
BOOKING_HOLD_MINUTES=15
# Default GST/tax percentage applied to ticket subtotals.
DEFAULT_TAX_PERCENT=18
# Per-order convenience fee (%)
DEFAULT_CONVENIENCE_FEE_PERCENT=2

# ── Frontend (web workspace) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_NAME=Tixit
# Canonical production URL — used for canonical tags, sitemap.xml and Open Graph.
# Set this to your real domain (e.g. https://www.tixit.in) in production.
NEXT_PUBLIC_SITE_URL=https://www.tixit.in
